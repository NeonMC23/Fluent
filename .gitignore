# Rust build output
/target/

# Local NLLB-200 model assets (multi-gigabyte, never commit). The README
# explains the required user-supplied layout and is intentionally tracked.
/models/*
!/models/README.md
*.gguf
*.safetensors
*.bin
*.pth

# Python legacy components
__pycache__/
*.py[cod]
.venv/
venv/

